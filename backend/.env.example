# HappyHome 后端配置示例
# 复制为 .env 后按需修改：cp .env.example .env
#
# 注意：.env 已被 .gitignore 排除，绝不要提交（含密钥）。
# 数据库使用 sql.js 单文件 SQLite（backend/happyhome.db），不需要 PostgreSQL 连接参数。
# SMTP 配置存放在数据库 settings 表中，由后台「设置」页维护，不走环境变量。

# 服务端口
PORT=3002

# JWT 签名密钥 —— 生产环境必须改成足够长的随机串，例如：
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 修改此项会让所有已签发的 token 立即失效（用户需重新登录）。
JWT_SECRET=change-me-to-a-long-random-string

# token 有效期
JWT_EXPIRES_IN=7d

# 允许跨域访问的来源，逗号分隔。留空则允许所有来源（仅建议本地开发使用）。
# 生产环境请显式列出来源，例如：https://blog.example.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3002

# 访客评论限流（IP 与邮箱双维度）。默认 10 次 / 10 分钟。
# 本地需要反复跑冒烟测试时可以把上限调高，生产环境请保持较小的值。
COMMENT_RATE_LIMIT_MAX=10
COMMENT_RATE_LIMIT_WINDOW_MS=600000